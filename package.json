{
  "name": "discord-commit-webhook",
  "version": "1.0.0",
  "description": "GitHub Action that posts a push event summary to a Discord channel or thread via an incoming webhook.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "author": "Lord_ZuzurNC",
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@actions/core": "^3.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
